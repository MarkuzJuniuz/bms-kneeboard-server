<table>
    <caption class="leader">
        Weather
    </caption>
    {% for w in weather %}
    {% if loop.first %}
    <thead>
        <tr>
            {% for s in w %}
            <th>{{ s | trim_end_matches(pat=":") | lower }}</th>
            {% endfor %}
        </tr>
    </head>
    <tbody>
    {% continue %}
    {% endif %}
    <tr>
        {% for s in w %}
        <td>{{ s }}</td>
        {% endfor %}
    </tr>
    {% if loop.last %}
    </tbody>
    {% endif %}
    {% endfor %}
</table>
