<table>
    <caption class="leader">
        Steerpoints
    </caption>
    <thead>
        <tr>
            <th>#</th>
            <th>desc</th>
            <th>time</th>
            <th>dist</th>
            <th>hng</th>
            <th>alt</th>
            <th>act</th>
            <th>frm</th>
            <th>cmnt</th>
        </tr>
    </thead>
    <tbody>
        {% for sp in steerpoints %}
        <tr>
            <td>{{ sp.steerpoint }}</td>
            <td>{{ sp.description }}</td>
            <td>{{ sp.time }}</td>
            <td>{% if sp.distance %}{{ sp.distance }}nm{% endif %}</td>
            <td>{% if sp.heading %}{{ sp.heading }}°{% endif %}</td>
            <td>{{ sp.altitude }}</td>
            <td>{{ sp.action }}</td>
            <td>{{ sp.form }}</td>
            <td>{{ sp.comments }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
