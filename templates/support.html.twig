<table>
    <caption class="leader">
        Support
    </caption>
    <thead>
        <tr>
            <th>callsign</th>
            <th>type</th>
            <th>description</th>
        </tr>
    </head>
    <tbody>
    {% for w in support %}
    <tr>
    {% if w | length == 1 %}<td></td><td></td>{% endif %}
