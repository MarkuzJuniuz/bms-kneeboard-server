<table>
    <caption class="leader">
        Comm Ladder
    </caption>
    <thead>
        <tr>
            <th>agency</th>
            <th>callsign</th>
            <th>UHF [ch]</th>
            <th>VHF [ch]</th>
            <th>notes</th>
        </tr>
    </thead>
    <tbody>
        {% for comm in commladder %}
        <tr>
            <td>{{ comm.agency }}</td>
            <td>{{ comm.callsign }}</td>
            <td>{{ comm.uhf }}</td>
            <td>{{ comm.vhf }}</td>
            <td>{{ comm.notes }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
