
<table>
    <caption class="leader">
        Pilot Roster
    </caption>
    <thead>
        <tr>
            <th>callsign</th>
            <th>lead</th>
            <th>wing</th>
            <th>element</th>
            <th>four</th>
        </tr>
    </thead>
    <tbody>
        {% for group in roster %}
        <tr{% if group.primary %} class="primary"{% endif %}>
            <td>{{ group.callsign }}</td>
            <td>{{ group.lead }}</td>
            <td>{{ group.wing }}</td>
            <td>{{ group.element }}</td>
            <td>{{ group.four }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
